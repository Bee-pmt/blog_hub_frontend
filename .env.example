# Public API origin, including the backend prefix. No secrets belong here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5300/api/v1

# Server-only Google OAuth configuration. Never use NEXT_PUBLIC_ for secrets.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google redirect URI: http://localhost:3000/api/auth/callback/google
# Set the backend GOOGLE_CLIENT_ID to the same value as AUTH_GOOGLE_ID.
